# Copy this file to .env and fill in your own key.
GROQ_API_KEY=Your_GROQ_API_KEY_here
GROQ_EXTRACTION_MODEL=gemma2-9b-it
GROQ_REASONING_MODEL=llama-3.3-70b-versatile

# Defaults to local SQLite. For the mandated stack, use one of:
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/aivoa
# DATABASE_URL=mysql+pymysql://user:pass@localhost:3306/aivoa
DATABASE_URL=sqlite:///./aivoa.db
